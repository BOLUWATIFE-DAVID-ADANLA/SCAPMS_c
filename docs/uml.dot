digraph SCAPMS {
  graph [rankdir=BT, splines=ortho, nodesep=0.45, ranksep=0.7, fontname="Helvetica", bgcolor="white", pad=0.3,
         label="SCAPMS Class Diagram (Model / Controller / Utilities)", labelloc=t, fontsize=20];
  node  [shape=plaintext, fontname="Helvetica", fontsize=10];
  edge  [fontname="Helvetica", fontsize=9];

  PatientRecord [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EEF2FD">
   <TR><TD><I>«abstract»</I></TD></TR><TR><TD><B><I>PatientRecord</I></B></TD></TR>
   <TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white">- id_, name_, contact_ : string<BR/>- age_ : int<BR/>- appointments_ : vector&lt;Appointment&gt;</TD></TR>
   <TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><I>+ getCategory() : PatientCategory = 0</I><BR/><I>+ getPriorityLevel() : int = 0</I><BR/><I>+ getPriorityLabel() : string = 0</I><BR/><I>+ getSummary() : string = 0</I><BR/><I>+ getExtraFields() : vector&lt;string&gt; = 0</I><BR/><I>+ clone() : unique_ptr&lt;PatientRecord&gt; = 0</I><BR/>+ setAge(int) / setName() / setContact()<BR/>+ attachAppointment(Appointment)<BR/>+ countAppointments(status) : int<BR/>+ nextAppointmentDateTime() : string</TD></TR>
  </TABLE>>];

  Appointable [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF6E5">
   <TR><TD><I>«interface»</I></TD></TR><TR><TD><B><I>Appointable</I></B></TD></TR>
   <TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><I>+ scheduleAppointment(Appointment) = 0</I><BR/><I>+ cancelAppointment(id) : bool = 0</I><BR/><I>+ maxPendingAppointments() : int = 0</I></TD></TR>
  </TABLE>>];

  GeneralPatient [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EEF2FD">
   <TR><TD><B>GeneralPatient</B></TD></TR>
   <TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white">- department_ : string<BR/>- insuranceId_ : string</TD></TR>
   <TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white">priority 2 "Normal", max 3 pending<BR/>+ overrides all pure virtuals</TD></TR>
  </TABLE>>];
  EmergencyPatient [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FDEDEE">
   <TR><TD><B>EmergencyPatient</B></TD></TR>
   <TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white">- severity_ : int (1-5)<BR/>- condition_ : string</TD></TR>
   <TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white">priority 1 "High Priority", max 5 pending<BR/>+ isCritical() : bool</TD></TR>
  </TABLE>>];
  FollowUpPatient [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EEF8F2">
   <TR><TD><B>FollowUpPatient</B></TD></TR>
   <TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white">- previousVisitDate_ : string<BR/>- referringDoctor_ : string</TD></TR>
   <TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white">priority 3 "Scheduled", max 2 pending<BR/>appointment must be after previous visit</TD></TR>
  </TABLE>>];

  Appointment [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F4F5F8">
   <TR><TD><B>Appointment</B></TD></TR>
   <TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white">- id_, patientId_, date_, time_, reason_<BR/>- status_ : AppointmentStatus</TD></TR>
   <TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white">+ getDateTime() : string<BR/>+ isPending() : bool<BR/>+ setStatus(status)</TD></TR>
  </TABLE>>];

  ClinicDatabase [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F4F5F8">
   <TR><TD><B>ClinicDatabase</B></TD></TR>
   <TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white">- patients_ : vector&lt;unique_ptr&lt;PatientRecord&gt;&gt;<BR/>- waitingQueue_ : queue&lt;QueueEntry&gt;<BR/>- recentPatients_ : PatientRecord*[10]<BR/>- sortedBy_ : SortField</TD></TR>
   <TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white">+ addPatient() / removePatient() / replacePatient()<BR/>+ enqueue() / dequeue()<BR/>+ touch() / invalidateCache()</TD></TR>
  </TABLE>>];

  ClinicManager [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EDE7F8">
   <TR><TD><B>ClinicManager</B> (facade)</TD></TR>
   <TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white">- db_ : ClinicDatabase<BR/>- undoStack_ : stack&lt;UndoAction&gt;<BR/>- patientIds_, appointmentIds_ : IDGenerator</TD></TR>
   <TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white">+ registerPatient() / updatePatient() / deletePatient()<BR/>+ processPatient(const PatientRecord&amp;) : string<BR/>+ search() / sort() / undoLast()<BR/>+ save() / load() / exportCsv()</TD></TR>
  </TABLE>>];

  AppointmentController [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EDE7F8">
   <TR><TD><B>AppointmentController</B></TD></TR>
   <TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white">+ schedule() / cancel() / complete()<BR/>+ remove() / restore() / all()</TD></TR>
  </TABLE>>];
  SearchEngine [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EDE7F8">
   <TR><TD><B>SearchEngine</B></TD></TR>
   <TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white">+ linearSearchById()<BR/>+ binarySearchById() / binarySearchByName()<BR/>+ recursiveSearchByName()<BR/>+ recursiveBinarySearchById()</TD></TR>
  </TABLE>>];
  SortEngine [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EDE7F8">
   <TR><TD><B>SortEngine</B></TD></TR>
   <TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white">+ selectionSort() / insertionSort()<BR/>+ mergeSort() / quickSort()<BR/>+ compare(a, b, field) : int</TD></TR>
  </TABLE>>];
  ReportGenerator [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EDE7F8">
   <TR><TD><B>ReportGenerator</B></TD></TR>
   <TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white">+ mostFrequentlyAttended()<BR/>+ pendingAppointments()<BR/>+ categoryDistribution()<BR/>+ dailySummary()</TD></TR>
  </TABLE>>];

  FileHandler [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E9F5F6">
   <TR><TD><B>FileHandler</B></TD></TR>
   <TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white">+ save() / load()<BR/>+ exportCsv() / importCsv()</TD></TR>
  </TABLE>>];
  IDGenerator [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E9F5F6">
   <TR><TD><B>IDGenerator</B></TD></TR>
   <TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white">+ next() / peek() / observe()</TD></TR>
  </TABLE>>];
  ClinicException [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FDEDEE">
   <TR><TD><B>ClinicException</B> : std::runtime_error</TD></TR>
   <TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white">ValidationException, DuplicateIdException,<BR/>NotFoundException, FileException,<BR/>OperationException</TD></TR>
  </TABLE>>];

  // Inheritance (hollow triangle)
  {GeneralPatient EmergencyPatient FollowUpPatient} -> PatientRecord [arrowhead=empty, arrowsize=1.2];
  // Interface realisation (dashed, hollow triangle)
  {GeneralPatient EmergencyPatient FollowUpPatient} -> Appointable [arrowhead=empty, style=dashed, arrowsize=1.2];
  // Composition (filled diamond at owner)
  Appointment -> PatientRecord [arrowhead=diamond, xlabel="1..*  owns", arrowsize=1.3];
  PatientRecord -> ClinicDatabase [arrowhead=diamond, xlabel="0..*  owns", arrowsize=1.3];
  ClinicDatabase -> ClinicManager [arrowhead=diamond, arrowsize=1.3];
  AppointmentController -> ClinicManager [arrowhead=diamond, arrowsize=1.3];
  // Dependencies / use
  ClinicManager -> SearchEngine [style=dashed, arrowhead=open, xlabel="uses"];
  ClinicManager -> SortEngine [style=dashed, arrowhead=open, xlabel="uses"];
  ClinicManager -> FileHandler [style=dashed, arrowhead=open, xlabel="uses"];
  ClinicManager -> IDGenerator [arrowhead=diamond, arrowsize=1.3];
  ReportGenerator -> ClinicDatabase [style=dashed, arrowhead=open, xlabel="reads"];
  AppointmentController -> Appointable [style=dashed, arrowhead=open, xlabel="books via"];
  FileHandler -> ClinicException [style=dashed, arrowhead=open, xlabel="throws"];
}
